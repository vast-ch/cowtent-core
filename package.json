{
  "name": "cowtent-core",
  "version": "0.9.0",
  "private": true,
  "description": "cowtent (cow + tent = content): the platform of an outdoor blog. Markdown posts with photos, facts and filters, built into a static site.",
  "repository": "github:vast-ch/cowtent-core",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Michal Bryxí",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "BLOG_CONTENT=tests/fixtures/content node bin/cowtent.mjs build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "start": "BLOG_CONTENT=tests/fixtures/content node bin/cowtent.mjs start",
    "test": "node --test 'tests/lib/*.test.mjs' && pnpm build:test && testem ci --port 0",
    "build:test": "EMBER_ENV=test vite build --mode development --outDir dist",
    "test:output": "BLOG_CONTENT=tests/fixtures/content node --test tests/output/site.test.mjs"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.13",
    "@eslint/js": "^9.39.5",
    "@glint/ember-tsc": "^1.14.3",
    "@glint/template": "^1.11.1",
    "@glint/tsserver-plugin": "^2.7.16",
    "@types/leaflet": "^1.9.22",
    "@types/qunit": "^2.19.14",
    "concurrently": "^9.2.5",
    "ember-qunit": "^9.2.0",
    "ember-template-lint": "^7.9.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-warp-drive": "^5.9.1",
    "globals": "^16.5.0",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "testem": "^3.21.5",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/runtime": "^7.29.13",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/test-helpers": "^5.8.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.6.10",
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.8.0",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/rokkitt": "^5.3.0",
    "@frontile/theme": "0.18.10",
    "@glimmer/component": "^2.2.1",
    "@responsive-image/core": "^2.1.1",
    "@responsive-image/ember": "^3.1.1",
    "@responsive-image/vite-plugin": "^3.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@vite-pwa/assets-generator": "2.0.0",
    "@warp-drive/core": "~5.9.1",
    "@warp-drive/ember": "~5.9.1",
    "@warp-drive/json-api": "~5.9.1",
    "@warp-drive/utilities": "~5.9.1",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "decorator-transforms": "^2.4.0",
    "ember-intl": "9.4.0",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-source": "~7.4.0",
    "ember-strict-application-resolver": "^0.1.1",
    "exifr": "^7.1.3",
    "feed": "^6.0.0",
    "frontile": "0.18.10",
    "leaflet": "^1.9.4",
    "mdast-util-to-string": "^4.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "vite": "^8.3.6",
    "vite-ember-ssr": "^0.7.0",
    "vite-plugin-pwa": "2.0.0",
    "yaml": "^2.8.1"
  },
  "bin": {
    "cowtent": "./bin/cowtent.mjs"
  },
  "files": [
    "app",
    "bin",
    "lib",
    "languages",
    "types",
    "index.html",
    "babel.config.mjs",
    "vite.config.mjs",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "tests/output"
  ]
}
